---
layout: null
sitemap: false
---
[{% for p in site.posts %}{% assign cat = site.data.categories[p.categoria] %}{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"category":{{ cat.short | default: p.categoria | jsonify }},"description":{{ p.description | default: p.excerpt | strip_html | truncate: 200 | jsonify }},"tags":{{ p.tags | join: " " | jsonify }},"date":"{{ p.date | date: '%Y-%m-%d' }}"}{% unless forloop.last %},{% endunless %}{% endfor %}]
